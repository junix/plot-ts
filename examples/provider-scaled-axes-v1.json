{
  "schema_version": "plot-ts.svg-scaled-figure/v1",
  "figure": { "width": 1200, "height": 460, "columns": 2, "theme": "sage", "surfacePolicy": "themed-v1" },
  "charts": [
    {
      "type": "line", "axes": "scaled-axes-v1", "xScale": "log10", "yScale": "log10",
      "xDomain": [1, 1000], "yDomain": [1, 1000000], "xUnit": "Hz", "unit": "W",
      "legend": "series-names-v1", "x": [1, 10, 100, 1000],
      "series": [{ "name": "Supplied power", "y": [1, 100, null, 1000000] }]
    },
    {
      "type": "scatter", "axes": "scaled-axes-v1", "xScale": "linear", "yScale": "log10",
      "xDomain": [0, 4], "yDomain": [0.1, 1000], "xUnit": "s", "unit": "counts",
      "points": [{ "x": 1, "y": 1, "size": 4 }, { "x": 2, "y": 10, "size": 6 }, { "x": 3, "y": 100, "size": 8 }]
    }
  ]
}
