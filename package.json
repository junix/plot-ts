{
  "name": "plot-ts",
  "version": "1.0.0",
  "description": "Universal TypeScript plotting library with dual engines: ECharts for browser interaction, pure SVG for server-side reporting. Matplotlib-style API.",
  "main": "dist/plot-ts.js",
  "module": "dist/plot-ts.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/plot-ts.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.svg.config.ts && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit",
    "test:package": "npm run build && node --test tests/package-exports.test.mjs"
  },
  "peerDependencies": {
    "echarts": ">=5.0.0"
  },
  "keywords": [
    "plot",
    "chart",
    "matplotlib",
    "visualization",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/plotly.js": "^3.0.10",
    "canvas": "^3.2.3",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "plotly.js": "^3.7.0",
    "recharts": "^3.10.1"
  },
  "files": [
    "dist"
  ]
}
